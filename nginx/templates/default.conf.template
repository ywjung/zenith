# ---------------------------------------------------------------------------
# Upstream 정의 — api/web 모두 변수 기반 proxy_pass.
# 정적 upstream 블록은 기동 시 DNS를 1회만 조회하고 이후 캐싱하므로,
# 컨테이너 재생성으로 IP가 바뀌면 nginx를 재시작해야 502가 해소된다.
# 변수 기반 proxy_pass + resolver valid=10s 조합은 TTL 만료마다 재해석해
# 배포 중 502를 자동 복구한다. (오픈소스 nginx 제약: 변수 기반에서는
# upstream keepalive 사용 불가 → Next.js 서버는 초당 수천 req가 아니므로 허용)
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Rate limiting 존 — 메모리 10MB = 약 160,000 IP 추적 가능
# ---------------------------------------------------------------------------
limit_req_zone $binary_remote_addr zone=api_general:10m  rate=60r/s;
limit_req_zone $binary_remote_addr zone=auth_login:10m   rate=10r/m;
limit_req_zone $binary_remote_addr zone=auth_sensitive:5m rate=5r/m;   # sudo/exchange
limit_req_zone $binary_remote_addr zone=admin_api:10m    rate=5r/s;    # 관리자 API
limit_req_zone $binary_remote_addr zone=ws_connect:5m    rate=10r/m;   # WebSocket 연결
limit_conn_zone $binary_remote_addr zone=ws_conn:10m;                   # WebSocket 동시 연결
limit_req_status 429;
limit_conn_status 429;

# Docker 내장 DNS — 컨테이너 IP 변경 시 10초마다 재조회 (배포 후 502 방지)
resolver 127.0.0.11 valid=10s;
resolver_timeout 5s;

# /_next/static/ 캐시 정책: 2xx만 immutable, 그 외는 no-store.
# 과거 설정 오류(3xx redirect가 immutable 캐시)가 1년 재발 불가능하도록 방어.
map $status $_next_static_cc {
  default "no-store, must-revalidate";
  "~^2"   "public, max-age=31536000, immutable";
}
map $status $_static_asset_cc {
  default "no-store, must-revalidate";
  "~^2"   "public, max-age=604800, immutable";
}

server {
  listen 80;

  server_tokens off;   # nginx 버전 노출 방지

  # ---------------------------------------------------------------------------
  # 기본 타임아웃 / 버퍼 설정
  # ---------------------------------------------------------------------------
  keepalive_timeout   75s;
  send_timeout        30s;
  client_header_timeout 15s;
  client_body_timeout   30s;

  proxy_connect_timeout  3s;    # 빠른 실패로 proxy_next_upstream 재시도 활성화
  proxy_send_timeout     30s;
  proxy_read_timeout     60s;

  # 배포 중 upstream 불안정 시 GET/idempotent 요청은 다른 upstream 시도 (재시도 1회).
  # POST 등 non-idempotent는 retry 대상 아님 (nginx 기본 동작).
  # SSE/WS location은 재시도 불가 → 각 location에서 proxy_next_upstream off로 차단.
  proxy_next_upstream error timeout http_502 http_503 http_504;
  proxy_next_upstream_tries 2;
  proxy_next_upstream_timeout 6s;

  proxy_buffer_size        8k;
  proxy_buffers            8 16k;
  proxy_busy_buffers_size  32k;

  # ---------------------------------------------------------------------------
  # gzip 압축 — API JSON 응답 크기 ~80% 감소
  # OPT: MIME 타입 확장, comp_level 6 (CPU↔크기 최적점), static 프리압축 활성화
  # ---------------------------------------------------------------------------
  gzip on;
  gzip_static on;           # .gz 파일 존재 시 on-the-fly 압축 생략 (Next.js static)
  gzip_types
    application/json
    application/javascript
    application/manifest+json
    text/plain text/css text/javascript text/xml
    application/xml application/xml+rss
    image/svg+xml
    font/woff2;
  gzip_min_length 512;      # 512B부터 압축 (이전 1024)
  gzip_comp_level 6;        # 4→6 (크기 ~5% 추가 감소, CPU 미미)
  gzip_vary on;
  gzip_proxied any;

  # ---------------------------------------------------------------------------
  # Security headers
  # ---------------------------------------------------------------------------
  add_header X-Frame-Options "DENY" always;
  add_header X-Content-Type-Options "nosniff" always;
  # SEC #9: X-XSS-Protection 제거 — Chrome M78에서 deprecated, XS-leak 유발 가능.
  # CSP nonce(middleware.ts)가 강력한 XSS 방어를 제공.
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  # H2: CSP는 Next.js middleware(src/middleware.ts)에서 nonce 기반으로 동적 생성
  # nginx에서 정적 CSP 헤더를 제거하여 middleware의 nonce 기반 CSP가 단독 적용되도록 함
  # (두 헤더가 동시 존재하면 브라우저가 AND 교집합 적용 — 더 엄격한 쪽이 우선)
  # HSTS — TLS 환경에서 유효. HTTP 리버스 프록시(nginx)에서 전송해도 브라우저는 HTTPS 응답에서만 처리
  # preload: HSTS Preload List 등록 가능 (https://hstspreload.org)
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
  # Cross-Origin 격리 — SharedArrayBuffer, COEP 관련 보안 강화
  add_header Cross-Origin-Opener-Policy "same-origin" always;
  add_header Cross-Origin-Resource-Policy "same-origin" always;

  # Chrome DevTools workspace detection (Chrome 130+)
  location = /.well-known/appspecific/com.chrome.devtools.json {
    return 200 '{}';
    add_header Content-Type application/json;
  }

  # ---------------------------------------------------------------------------
  # Next.js 정적 자산 — 장기 캐싱 (immutable, 1년)
  # Next.js는 빌드마다 해시가 바뀌어 캐시 무효화가 자동 처리됨
  # ---------------------------------------------------------------------------
  location /_next/static/ {
    set $web_backend http://itsm-web:3000;
    proxy_pass $web_backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # 2xx만 1년 immutable 캐시. 3xx(리다이렉트)·4xx·5xx는 캐시 금지 —
    # 과거 설정 오류로 3xx가 immutable 캐시되어 복구 불가한 사고 방지.
    proxy_hide_header Cache-Control;
    add_header Cache-Control $_next_static_cc always;
    access_log off;
  }

  # OPT: 정적 리소스 (아이콘, 매니페스트, 폰트, SW) — 장기 캐시
  location ~* \.(ico|svg|woff2?|ttf|eot)$ {
    set $web_backend http://itsm-web:3000;
    proxy_pass $web_backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # 2xx만 7일 immutable. 그 외는 no-store (3xx 캐시 사고 방지).
    proxy_hide_header Cache-Control;
    add_header Cache-Control $_static_asset_cc always;
    access_log off;
  }

  location / {
    set $web_backend http://itsm-web:3000;
    proxy_pass $web_backend;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_cache_bypass $http_upgrade;
    # 배포 중 upstream 불안정 시 자동 재시도 (502 사용자 노출 완화)
    proxy_connect_timeout 3s;
    proxy_next_upstream error timeout http_502 http_503 http_504;
    proxy_next_upstream_tries 3;
    proxy_next_upstream_timeout 10s;
  }

  # ---------------------------------------------------------------------------
  # SSE (Server-Sent Events) — 버퍼링 비활성화 필수
  # ---------------------------------------------------------------------------
  # resolver 변수 방식 사용 → 컨테이너 재생성 후 IP 변경 시에도 자동 재조회 (502 방지)
  # gzip off + X-Accel-Buffering: no → 청크 인코딩 중단(ERR_INCOMPLETE_CHUNKED_ENCODING) 방지
  # ---------------------------------------------------------------------------
  location /api/notifications/stream {
    set $sse_api http://itsm-api:8000;
    # 변수 기반 proxy_pass는 URI 접미사 미지원 → rewrite로 /api 제거 후 원본 URI 전달.
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass $sse_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection '';
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 86400s;
    chunked_transfer_encoding on;
    gzip off;                              # gzip 버퍼링이 SSE 청크를 끊음
    add_header X-Accel-Buffering "no";     # nginx 프록시 버퍼링 명시적 비활성
    proxy_next_upstream off;               # SSE는 재시도 불가 (스트림 중간 재연결은 클라가 담당)
  }

  # ---------------------------------------------------------------------------
  # 티켓 실시간 협업 WebSocket
  # ---------------------------------------------------------------------------
  location ~ ^/api/ws/tickets/ {
    # WebSocket 연결: IP당 10회/분, 동시 연결 20개 제한
    limit_req zone=ws_connect burst=5 nodelay;
    limit_conn ws_conn 20;
    set $ws_api http://itsm-api:8000;
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass $ws_api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 86400s;
    proxy_connect_timeout 10s;
    proxy_send_timeout 86400s;
    proxy_next_upstream off;               # WebSocket은 재시도 불가
  }

  # ---------------------------------------------------------------------------
  # 티켓 실시간 이벤트 SSE 스트림
  # ---------------------------------------------------------------------------
  location ~ ^/api/tickets/[0-9]+/stream {
    set $sse_api http://itsm-api:8000;
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass $sse_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection '';
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 86400s;
    chunked_transfer_encoding on;
    gzip off;
    add_header X-Accel-Buffering "no";
    proxy_next_upstream off;
  }

  # ---------------------------------------------------------------------------
  # 파일 프록시 — iframe 미리보기 허용을 위해 frame-ancestors를 'self'로 오버라이드
  # ---------------------------------------------------------------------------
  location /api/tickets/uploads/proxy {
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'self';" always;
    set $api_backend "http://itsm-api:8000";
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass $api_backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_socket_keepalive on;
  }

  # ---------------------------------------------------------------------------
  # 로그인 엔드포인트만 rate limit 강화 (brute-force 방지)
  # /api/auth/me, /api/auth/callback 등은 일반 API 존 적용
  # ---------------------------------------------------------------------------
  location = /api/auth/login {
    limit_req zone=auth_login burst=5 nodelay;
    set $api_backend "http://itsm-api:8000";
    rewrite ^ /auth/login break;
    proxy_pass $api_backend;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # SEC #4: sudo / exchange / refresh — 민감 인증 엔드포인트: nginx 레벨 5회/분 추가 제한
  # refresh 토큰 endpoint도 brute-force 표적이 될 수 있으므로 sensitive zone 적용.
  location ~ ^/api/auth/(sudo|exchange|refresh) {
    limit_req zone=auth_sensitive burst=2 nodelay;
    set $api_backend "http://itsm-api:8000";
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass $api_backend;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # 티켓 AI 엔드포인트 — 대형 로컬 모델(35B+) 요약/분류 추론 대기를 위해 타임아웃 연장
  location ~ ^/api/tickets/[0-9]+/ai-(summary|classify) {
    limit_req zone=api_general burst=5 nodelay;
    set $api_backend "http://itsm-api:8000";
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass $api_backend;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout    180s;
    proxy_send_timeout    180s;
    proxy_connect_timeout  10s;
    client_max_body_size 1m;
  }

  # ai-suggest (실시간 분류 제안) — POST /api/tickets/ai-suggest
  location = /api/tickets/ai-suggest {
    limit_req zone=api_general burst=5 nodelay;
    set $api_backend "http://itsm-api:8000";
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass $api_backend;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout    180s;
    proxy_send_timeout    180s;
    proxy_connect_timeout  10s;
    client_max_body_size 1m;
  }

  # 관리자 API — 5 req/s 제한 (대규모 bulk 작업 방지)
  # AI 엔드포인트 — 대형 로컬 모델(35B+) 응답 대기를 위해 타임아웃 연장
  location ~ ^/api/admin/ai-settings/(test|ollama-models) {
    limit_req zone=admin_api burst=5 nodelay;
    set $api_backend "http://itsm-api:8000";
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass $api_backend;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout    180s;
    proxy_send_timeout    180s;
    proxy_connect_timeout  10s;
    client_max_body_size 1m;
  }

  location /api/admin/ {
    limit_req zone=admin_api burst=10 nodelay;
    set $api_backend "http://itsm-api:8000";
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass $api_backend;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 20m;
  }

  # ---------------------------------------------------------------------------
  # Health check — Docker healthcheck 전용, 로그 제외
  # ---------------------------------------------------------------------------
  location = /health {
    set $api_backend "http://itsm-api:8000";
    rewrite ^ /health break;
    proxy_pass $api_backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    access_log off;
  }

  # ---------------------------------------------------------------------------
  # 일반 API — rate limit 적용
  # ---------------------------------------------------------------------------
  location /api/ {
    limit_req zone=api_general burst=100 delay=20;
    set $api_backend "http://itsm-api:8000";
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass $api_backend;
    # FastAPI trailing-slash redirect URL을 클라이언트 origin으로 재작성
    proxy_redirect ~^https?://[^/]+(/.*)$ $scheme://$http_host/api$1;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 20m;
  }

  # ---------------------------------------------------------------------------
  # HIGH-07: Prometheus metrics — 내부망 IP + X-Metrics-Token 헤더 이중 인증
  # ---------------------------------------------------------------------------
  location = /metrics {
    allow 127.0.0.1;
    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    deny all;
    set $metrics_expected "${METRICS_TOKEN}";
    # METRICS_TOKEN이 비어 있으면 설정 오류 — 모든 요청 차단 (우회 방지)
    if ($metrics_expected = "") {
      return 503 "Metrics endpoint not configured";
    }
    if ($http_x_metrics_token != $metrics_expected) {
      return 403;
    }
    set $api_backend "http://itsm-api:8000";
    rewrite ^ /metrics break;
    proxy_pass $api_backend;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  # ---------------------------------------------------------------------------
  # Swagger UI / ReDoc — 내부망 IP만 허용
  # ---------------------------------------------------------------------------
  location /docs {
    allow 127.0.0.1;
    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    deny all;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; frame-ancestors 'none';" always;
    set $api_backend "http://itsm-api:8000";
    rewrite ^ /docs break;
    proxy_pass $api_backend;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location /docs/oauth2-redirect {
    allow 127.0.0.1;
    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    deny all;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; frame-ancestors 'none';" always;
    set $api_backend "http://itsm-api:8000";
    rewrite ^ /docs/oauth2-redirect break;
    proxy_pass $api_backend;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location /redoc {
    allow 127.0.0.1;
    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    deny all;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; frame-ancestors 'none';" always;
    set $api_backend "http://itsm-api:8000";
    rewrite ^ /redoc break;
    proxy_pass $api_backend;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location /openapi.json {
    allow 127.0.0.1;
    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    deny all;
    set $api_backend "http://itsm-api:8000";
    rewrite ^ /openapi.json break;
    proxy_pass $api_backend;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  # ---------------------------------------------------------------------------
  # Grafana 대시보드 (내부망 전용)
  # ---------------------------------------------------------------------------
  location ~ ^/grafana(/.*)?$ {
    allow 127.0.0.1;
    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    deny all;
    proxy_pass http://grafana:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_redirect ~^https?://[^/]+(/.*)$ $scheme://$http_host$1;
  }

  # ---------------------------------------------------------------------------
  # Prometheus (내부망 전용 + HTTP Basic Auth)
  # .env에서 PROMETHEUS_HTPASSWD 설정 필요:
  #   htpasswd -nB prometheus_user  →  "prometheus_user:$2y$..."
  #   또는: python -c "import bcrypt; print('admin:' + bcrypt.hashpw(b'password', bcrypt.gensalt(12)).decode())"
  # ---------------------------------------------------------------------------
  location ~ ^/prometheus(/.*)?$ {
    allow 127.0.0.1;
    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    deny all;

    proxy_pass http://prometheus:9090;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_redirect ~^https?://[^/]+(/.*)$ $scheme://$http_host$1;
  }

  # ---------------------------------------------------------------------------
  # Celery Flower 모니터링 (내부망 전용)
  # ---------------------------------------------------------------------------
  location /flower/ {
    allow 127.0.0.1;
    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    deny all;
    proxy_pass http://flower:5555/flower/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
  }
}

# ---------------------------------------------------------------------------
# OpenAI Codex OAuth — loopback redirect 전용 리스너
# auth.openai.com 이 허용하는 redirect_uri: http://localhost:1455/auth/callback
# 포트 1455는 OpenAI 측에 고정 등록된 값 (변경 불가)
# ---------------------------------------------------------------------------
server {
  listen 1455;
  server_name localhost;

  location = /auth/callback {
    set $api_backend "http://itsm-api:8000";
    rewrite ^ /admin/ai-settings/openai-oauth/callback break;
    proxy_pass $api_backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
    proxy_connect_timeout 10s;
  }
}
